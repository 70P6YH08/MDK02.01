<Window x:Class="LabWork3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBlock Text="Поиск:" Margin="0 0 5 0"/>
            <TextBox Width="300"/>
            <Button Content="Найти" Margin="5 0 0 0"/>
        </StackPanel>
        
        <DataGrid ItemsSource="{Binding Data}" Grid.Row="1"/>
        
        <StackPanel Margin="5" Grid.Row="2" Orientation="Horizontal">
            <Button Content="Экспорт" Margin="0 0 5 0"/>
            <Button Content="Импорт" Margin="5 0 0 0"/>
            <RadioButton Content="По убыванию" Checked="{Binding IsDescOrder}"/>
            <RadioButton Content="По возрастанию" Checked="{Binding IsAscOrder}"/>
        </StackPanel>
        
    </Grid>
</Window>
