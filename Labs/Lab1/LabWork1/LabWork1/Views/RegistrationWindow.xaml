<Window x:Class="LabWork1.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork1.Views"
        mc:Ignorable="d"
        Title="RegistrationWindow" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Регистрация" Grid.Column="1" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="Логин" Grid.Row="1"/>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="1">
                <TextBox Width="150"/>
            </Border>
            <Label Content="Пароль" Grid.Row="2"/>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Row="2" Grid.Column="1">
                <TextBox Width="150"/>
            </Border>
            <Label Content="Повтор пароля" Grid.Row="3"/>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Row="3" Grid.Column="1">
                <TextBox Width="150"/>
            </Border>
            <Label Content="Почта" Grid.Row="4"/>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="4">
                <TextBox Width="150"/>
            </Border>
            <CheckBox x:Name="AgreementCheckBox" Grid.Row="5" Grid.ColumnSpan="2">
                <TextBlock Text="Я принимаю пользовательское соглашение" FontSize="10"/>
            </CheckBox>
            <Button Grid.ColumnSpan="2" Grid.Row="6" Content="Авторизироваться" IsEnabled="{Binding IsChecked, ElementName=AgreementCheckBox}" Command="{Binding RegistrationUserCommand}" CommandParameter="{Binding ElementName=UserPasswordBox}"/>
            <Label Content="Есть аккаунт?" Grid.Row="7"/>
            <Button Grid.Column="1" Grid.Row="7" Background="Beige" Content="Авторизироваться" FontWeight="Bold" Command="{Binding ToAuthorizationWindowCommand}"/>
        </Grid>
    </StackPanel>
</Window>
