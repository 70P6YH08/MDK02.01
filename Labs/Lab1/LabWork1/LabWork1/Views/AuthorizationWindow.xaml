<Window x:Class="LabWork1.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork1.Views"
        mc:Ignorable="d"
        Title="AuthorizationWindow" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Label Content="Авторизация" Grid.Column="1" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="Логин"/>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1">
                <TextBox Width="150" Text="{Binding Login}"/>
            </Border>
            <Label Content="Пароль" Grid.Row="1"/>
            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="1">
                <PasswordBox x:Name="UserPasswordBox" Width="150" PasswordChar="*"/>
            </Border>
            <Button Grid.ColumnSpan="2" Grid.Row="2" Content="Авторизироваться" Command="{Binding AuthorizationUserAsyncCommand}" CommandParameter="{Binding ElementName=UserPasswordBox}"/>
            <Label Content="Нет аккаунта?" Grid.Row="3"/>
            <Button Grid.Column="1" Grid.Row="3" Background="HotPink" Content="Зарегистрироваться" FontWeight="Bold" Command="{Binding ToRegistrationWindowCommand}"/>
        </Grid>
    </StackPanel>
</Window>
