<Window x:Class="LabWork1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding DataView}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Button Content="Импорт" Width="100" Margin="0 0 5 0" Command="{Binding ImportExcelDataCommand}"/>
            <Button Content="Экспорт" Width="100" Command="{Binding ExportExcelDataCommand}"/>
        </StackPanel>
    </Grid>
</Window>
