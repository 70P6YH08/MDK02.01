<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBlock Text="Поиск:" Margin="0 0 5 0"/>
            <TextBox x:Name="searchTextBox" Width="300"/>
            <Button x:Name="searchButton" Content="Найти" Margin="5 0 0 0"/>
        </StackPanel>

        <DataGrid x:Name="usersDataGrid" Grid.Row="1" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}"/>
                <DataGridTextColumn Header="Почта" Binding="{Binding Email}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Margin="5" Grid.Row="2" Orientation="Horizontal">
            <RadioButton x:Name="descOrderRadioButton" Content="По убыванию"/>
            <RadioButton x:Name="ascOrderRadioButton" Content="По возрастанию"/>
        </StackPanel>

    </Grid>
</Window>
