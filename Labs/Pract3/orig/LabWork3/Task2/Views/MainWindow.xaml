<Window x:Class="Task2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBlock Text="Поиск:" Margin="0 0 5 0"/>
            <TextBox Width="300" Text="{Binding SearchTextBox}"/>
            <Button Width="100" Content="Найти" Command="{Binding SearchDataCommand}"/>
            <TextBlock Text="Фильтровать:" Margin="5 0 5 0"/>
            <ComboBox Margin="0 0 15 0" ItemsSource="{Binding SortComboBox}" SelectedItem="{Binding SortComboBox, Mode=TwoWay}">
                <ComboBoxItem Content="По логину" Tag="Login"/>
                <ComboBoxItem Content="По роли" Tag="Role"/>
                <ComboBoxItem Content="По почте" Tag="Email"/>
                <ComboBoxItem Content="По привилегии" Tag="Privilege"/>
                <ComboBoxItem Content="По статусу" Tag="Status"/>
            </ComboBox>

            <StackPanel Margin="5" Grid.Row="2" Orientation="Horizontal">
                <RadioButton GroupName="userDtosSort" Content="По возрастанию" Margin="0 0 5 0" />
                <RadioButton GroupName="userDtosSort" Content="По убыванию" Margin="0 0 5 0"/>
            </StackPanel>
        </StackPanel>

        <DataGrid ItemsSource="{Binding UserDtosView}" Grid.Row="1" AutoGenerateColumns="False"
                  SelectedItem="{Binding Path=UserDtoSelected, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                <DataGridTextColumn Header="Почта" Binding="{Binding Email}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <DockPanel Grid.Row="2" HorizontalAlignment="Center">
            <Button Command="{Binding PreviousPageButtonCommand}" Content="&lt;" Margin="5 5 10 5" Width="20" Height="30"/>
            <Button Command="{Binding NextPageButtonCommand}" Content="&gt;" Margin="10 5 5 5" Width="20" Height="30"/>
        </DockPanel>
    </Grid>
</Window>
